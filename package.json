{
  "name": "flip-canvas",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-post-install": "node scripts/sync-store-admob.js",
    "export:server": "expo export --platform web --no-ssg",
    "deploy:api:preview": "npm run export:server && npx eas-cli@latest deploy --environment preview",
    "deploy:api": "npm run export:server && npx eas-cli@latest deploy --environment production --prod",
    "build:beta": "npx eas-cli@latest build --platform all --profile beta",
    "submit:beta": "npx eas-cli@latest submit --platform all --profile beta --latest",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node .test-build/tests/run-tests.js"
  },
  "dependencies": {
    "@expo-google-fonts/gaegu": "^0.4.1",
    "@fal-ai/client": "^1.10.1",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "15.7.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
