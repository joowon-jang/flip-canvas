# 기본 줄바꿈 규칙: 모든 텍스트 파일은 LF 사용
* text=auto eol=lf

# 압축 파일은 텍스트로 취급하지 않음
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff2 binary

# 폰드 파일
*.ttf binary
*.otf binary

# JSON, JS/TS, JSX/TSX, CSS 등 코드 파일은 LF 강제
*.json text
*.js text
*.ts text
*.tsx text
*.jsx text
*.css text
*.scss text
*.html text
*.md text
